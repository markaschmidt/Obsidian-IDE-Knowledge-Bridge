{
  "name": "obsidian-ide-knowledge-bridge",
  "version": "0.5.0",
  "private": true,
  "description": "Workspace-scoped knowledge exchange between Obsidian, Cursor and VS Code",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:stdio": "tsx --test tests/integration/*.test.ts",
    "test:ui": "tsx --test tests/ui/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:stdio",
    "package:extension": "npm run build && cd apps/vscode-extension && vsce package --no-dependencies --out ../../dist/obsidian-ide-knowledge-bridge.vsix",
    "demo": "tsx scripts/demo.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/picomatch": "^4.0.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.2.0",
    "playwright": "^1.64.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@knowledge-bridge/core": "https://codeload.github.com/markaschmidt/KnowledgeBridgeCore/tar.gz/c88012fffd6b7f38a211f60281489d5690fc8587"
  }
}
